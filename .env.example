# Supabase Yapılandırması (Canlı Veritabanı ve Auth için)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (Yalnızca sunucu tarafında çalışır, ASLA NEXT_PUBLIC_ prefix almaz)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron Güvenlik Anahtarı (İsteğe Bağlı)
CRON_SECRET=your-secure-cron-token

# VercelWatch Güvenlik ve Giriş Denetimi (https://vercel-website-security.vercel.app)
VERCEL_WATCH_URL=https://vercel-website-security.vercel.app
NEXT_PUBLIC_VERCEL_WATCH_URL=https://vercel-website-security.vercel.app
NEXT_PUBLIC_VERCEL_WATCH_PROJECT_ID=arti-temizlik-zuccaciye

